# Copy to .env on the box. Nothing here is needed for `docker compose up` locally.
POSTGRES_PASSWORD=change-me
# Cloudflare Tunnel (DRIFT §2): with a token the `tunnel` profile starts; the public hostname
# routes to http://app:8080 in the Cloudflare dashboard.
CLOUDFLARE_TUNNEL_TOKEN=
# R2 (DRIFT §4, §5): one account and key for both buckets. With credentials, rendered
# textures and print files go to R2_ASSETS_BUCKET and are served as short-lived signed links,
# and the `backup` profile starts against R2_BACKUP_BUCKET. Without them, assets stay in
# Postgres and are served through the app.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ASSETS_BUCKET=byd-assets
R2_BACKUP_BUCKET=byd-backup
# Base backups: the hour (UTC) and how many full backups to keep, with the WAL between them.
BACKUP_HOUR=03
BACKUP_KEEP=7
# Images from CI (DRIFT §7): with a registry, deploy.sh pulls ghcr.io/<owner>/<repo>/app:<sha>
# instead of building on the box. GHCR_TOKEN is a read:packages token if the packages are private.
BYD_REGISTRY=
GHCR_USER=
GHCR_TOKEN=
# Accounts (G1): where login links point, and mail through Resend (DRIFT §12). Without a key the
# link is printed to the app's log.
PUBLIC_ORIGIN=https://deck.example
RESEND_API_KEY=
MAIL_FROM=build-your-deck <login@deck.example>
# Local/manual testing only: bypasses the emailed link and creates the session immediately.
# The stack does not pass it to the container, so setting it here does nothing on the box.
AUTH_BYPASS=false
# Tables: unload after idle (ms), end after untouched (ms, C9).
IDLE_EVICT_MS=1800000
IDLE_END_MS=86400000
