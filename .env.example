# Copy to .env on the box. Nothing here is needed for `docker compose up` locally.
POSTGRES_PASSWORD=change-me
# Cloudflare Tunnel (DRIFT §2): with a token the `tunnel` profile starts; the public hostname
# routes to http://app:8080 in the Cloudflare dashboard.
CLOUDFLARE_TUNNEL_TOKEN=
# Backups to R2 (DRIFT §5): with credentials the `backup` profile starts.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=byd-backup
BACKUP_HOUR=03
# Tables: unload after idle (ms), end after untouched (ms, C9).
IDLE_EVICT_MS=1800000
IDLE_END_MS=86400000
