# Copy to .env on the box. Nothing here is needed for `docker compose up` locally.
POSTGRES_PASSWORD=change-me
# The way in (DRIFT §2). Two of them; pick the one the box calls for.
#
# A box that already carries a reverse proxy hands the app to it: set COMPOSE_FILE so the overlay
# is merged in, and BYD_HOSTNAME to the host the proxy should route — the same host as in
# PUBLIC_ORIGIN below, or the login loops. The proxy holds the certificate and the DNS record.
COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
BYD_HOSTNAME=deck.example
# A box that has moved to a new host keeps the old one answering: add docker-compose.traefik-moved.yml
# to COMPOSE_FILE and name the old host here, and it answers 301 to BYD_HOSTNAME with the path and
# the query kept (A5, #1080). Leave both out on a box that never moved.
# BYD_MOVED_FROM=old.example
# A box without one brings its own: a token starts the `tunnel` profile, and the tunnel's public
# hostname is pointed at http://app:8080 in the Cloudflare dashboard. Leave COMPOSE_FILE unset
# then, so the overlay stays out.
CLOUDFLARE_TUNNEL_TOKEN=
# R2 (DRIFT §4, §5): one account and key for both buckets. With credentials, rendered
# textures and print files go to R2_ASSETS_BUCKET and are served as short-lived signed links,
# and the `backup` profile starts against R2_BACKUP_BUCKET. Without them, assets stay in
# Postgres and are served through the app.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ASSETS_BUCKET=byd-assets
R2_BACKUP_BUCKET=byd-backup
# Leave empty unless the buckets answer somewhere other than the account's own endpoint. They do
# when they were created in a jurisdiction: a bucket in the European one is invisible on
# https://<account>.r2.cloudflarestorage.com and answers 403 to credentials that are perfectly
# good, and wants https://<account>.eu.r2.cloudflarestorage.com instead. Also where a MinIO goes
# in development.
R2_ENDPOINT=
# Base backups: the hour (UTC) and how many full backups to keep, with the WAL between them.
BACKUP_HOUR=03
BACKUP_KEEP=7
# Images from CI (DRIFT §7): with a registry, deploy.sh pulls ghcr.io/<owner>/<repo>/app:<sha>
# instead of building on the box. GHCR_TOKEN is a read:packages token if the packages are private.
BYD_REGISTRY=
GHCR_USER=
GHCR_TOKEN=
# Accounts (G1): where login links point, and mail through Resend (DRIFT §12). Without a key the
# link is printed to the app's log.
# The same host as BYD_HOSTNAME, with the scheme. An inline comment would become part of the
# value here: systemd reads this file too, and it only treats a `#` at the start of a line.
PUBLIC_ORIGIN=https://deck.example
RESEND_API_KEY=
MAIL_FROM=Deckster <login@deck.example>
# The designers' own AI keys (#999, DRIFT §5) are sealed with this: 32 random bytes in base64, made
# once with `openssl rand -base64 32`. It lives here and in a password manager, never in the
# database or its backups. Lose it and every saved key reads as none, and designers are asked for
# their keys again; change it and the same happens. Empty, no key can be saved.
AI_KEY_SECRET=
# Where a beta tester turns (#757, DRIFT §8): an e-mail address, or a web address with http(s)://.
# The login card, My games, the login mail's foot and /health say it; empty, they leave it out.
BYD_CONTACT=
# The replay corpus (DRIFT §7, #1011): the accounts whose beta designers said yes, in the mail
# that invited them, to their sessions going into the corpus — comma-separated addresses — and
# the operator's own address. The operator's login may then read GET /sessions/:id/export for a
# table in their games and nothing else of theirs. Both or neither; read when the app starts,
# so an address taken off the list is shut out at the next restart.
BYD_CORPUS_ACCOUNTS=
BYD_OPERATOR=
# The tiers and their ceilings (#1193, A2, DRIFT §12): JSON on one line, in single quotes, e.g.
#   BYD_PLANS='{"default":"free","plans":{"free":{"projects":3},"pro":{}}}'
# A ceiling is a whole number or null (unlimited), and a measure a tier does not name is unlimited.
# Empty, nothing is limited — the beta's state. Read when the app starts; a value it cannot read,
# or one missing a tier an account has, stops the start, and the app's log says why.
BYD_PLANS=
# Local/manual testing only: bypasses the emailed link and creates the session immediately.
# The stack does not pass it to the container, so setting it here does nothing on the box.
AUTH_BYPASS=false
# Tables: unload after idle (ms), end after untouched (ms, C9).
IDLE_EVICT_MS=1800000
IDLE_END_MS=86400000
# Invitations are swept this long after they were used or ran out (ms, #1277, G6). Empty is the
# decided 30 days; a longer value is taken as 30 days.
INVITE_KEEP_MS=
