    "seed": "tsx scripts/seed.ts",
    "seed:project": "tsx scripts/seed-project.ts"
  },
  "dependencies": {
    "@byd/engine": "workspace:*",
    "@byd/protocol": "workspace:*",
    "postgres": "^3.4.5",
    "ws": "^8.18.0",
    "zod": "^4.0.0",
    "@byd/template": "workspace:*",
    "@byd/render": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./doc": "./src/doc.ts"
  }
