# Postgres with WAL-G (DRIFT §5). One image for the database and the backup agent: the archive
# command runs inside Postgres, the base backups and the restore rehearsal in the backup
# container over the same data volume. Alpine as before — the box's data was initialised on
# musl and a libc switch would change collations under the indexes — with gcompat for WAL-G's
# glibc build, pinned by version and checksum.
FROM postgres:17-alpine
ARG TARGETARCH
ARG WALG_VERSION=v3.0.9
ARG WALG_SHA256_AMD64=4f03ee4679db7f660bfd1b2b8291ac5df247cd2ec48074b60c112f4897299f24
ARG WALG_SHA256_ARM64=20191a37ad091a880c25f4cc907e6f0deb7f12bdd8a53fd62dbc7fcbf2eac712
RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) asset=wal-g-pg-22.04-amd64; sum="${WALG_SHA256_AMD64}" ;; \
      arm64) asset=wal-g-pg-22.04-aarch64; sum="${WALG_SHA256_ARM64}" ;; \
      *) echo "no WAL-G build for ${TARGETARCH}"; exit 1 ;; \
    esac; \
    apk add --no-cache gcompat curl; \
    curl -sSL -o /tmp/wal-g.tgz "https://github.com/wal-g/wal-g/releases/download/${WALG_VERSION}/${asset}.tar.gz"; \
    echo "${sum}  /tmp/wal-g.tgz" | sha256sum -c -; \
    tar -xzf /tmp/wal-g.tgz -C /tmp; \
    mv "/tmp/${asset}" /usr/local/bin/wal-g; \
    chmod +x /usr/local/bin/wal-g; \
    rm /tmp/wal-g.tgz; \
    wal-g --version
COPY archive.sh backup.sh restore.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/archive.sh /usr/local/bin/backup.sh /usr/local/bin/restore.sh
