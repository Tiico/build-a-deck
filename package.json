{
  "name": "build-your-deck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "proto": "pnpm --filter @byd/web dev --open /prototype/presence?variant=A",
    "dev:web": "pnpm --filter @byd/web dev",
    "dev:server": "pnpm --filter @byd/server dev",
    "dev:render": "pnpm --filter @byd/render worker"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
